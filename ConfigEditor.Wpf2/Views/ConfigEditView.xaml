<UserControl x:Class="ConfigEditor.Wpf2.Views.ConfigEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:ConfigEditor.Wpf2.Converters"
             xmlns:controls="clr-namespace:ConfigEditor.Wpf2.Controls"
             xmlns:vms="clr-namespace:ConfigEditor.Wpf2.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vms:ConfigEditViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <converters:PropertyWidthConverter x:Key="WidthConverter"/>
        <converters:TimeOnlyConverter x:Key="TimeOnlyConverter"/>
        <converters:StringBoolConverter x:Key="StringBoolConverter"/>
        <converters:StringDoubleConverter x:Key="StringDoubleConverter"/>
        <converters:ObjStringConverter x:Key="ObjStringConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="8">
            <Button Content="Open" Command="{Binding LoadConfigCommand}" Margin="0,0,8,0"/>
            <Button Content="Save" Command="{Binding SaveConfigCommand}"/>
        </StackPanel>

        <TabControl ItemsSource="{Binding ConfigInfo}" Grid.Row="1" Padding="10" SelectedIndex="0">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}"/>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Configs}"  Margin="10">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:PropertiyView   
                                        AddCommand="{Binding DataContext.AddArrayCommand,RelativeSource={RelativeSource AncestorType=TabControl}}"
                                        SetObjectCommand="{Binding DataContext.SetObjectCommand,RelativeSource={RelativeSource AncestorType=TabControl}}"
                                        CopyCommand="{Binding DataContext.CopyCommand,RelativeSource={RelativeSource AncestorType=TabControl}}"
                                        PasteCommand="{Binding DataContext.PasteCommand,RelativeSource={RelativeSource AncestorType=TabControl}}"
                                        Margin="2,0">
                                        <controls:PropertiyView.MinWidth>
                                            <MultiBinding Converter="{StaticResource WidthConverter}">
                                                <Binding Path="."/>
                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type ItemsControl}}"/>

                                            </MultiBinding>
                                        </controls:PropertiyView.MinWidth>
                                    </controls:PropertiyView>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </Grid>
</UserControl>