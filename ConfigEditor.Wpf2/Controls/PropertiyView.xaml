<UserControl x:Class="ConfigEditor.Wpf2.Controls.PropertiyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:ConfigEditor.Wpf2.Converters"
             xmlns:vms="clr-namespace:ConfigEditor.Wpf2.ViewModels"
             xmlns:local="clr-namespace:ConfigEditor.Wpf2.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vms:ConfigViewModel}"
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="page"
             Validation.ErrorTemplate="{x:Null}"
             Grid.IsSharedSizeScope="True">

    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Copy" 
                      Command="{Binding PlacementTarget.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="Paste" 
                      Command="{Binding PlacementTarget.PasteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>
    </UserControl.ContextMenu>

    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="tb">
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <!-- Icon-style button -->
        <Style x:Key="ButtonActionStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#1976D2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EAF4FF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#1976D2"/>
                                <Setter Property="Foreground" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D0E9FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ButtonDeleteStyle" TargetType="Button" BasedOn="{StaticResource ButtonActionStyle}">
            <Setter Property="Foreground" Value="#D32F2F"/>
            <Setter Property="BorderBrush" Value="#D32F2F"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFECEC"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#D32F2F"/>
                                <Setter Property="Foreground" Value="#D32F2F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFD6D6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <converters:Boolean2VisibilityConverter x:Key="Boolean2VisibilityConverter"/>
        <converters:String2VisibilityConverter x:Key="String2VisibilityConverter" Invert="False"/>
        <converters:String2VisibilityConverter x:Key="String2VisibilityReConverter" Invert="True"/>
        <converters:ObjStringConverter x:Key="ObjStringConverter"/>
        <converters:StringBoolConverter x:Key="StringBoolConverter"/>

        <!-- Two-column row templates using SharedSizeGroup to align labels -->
        <DataTemplate x:Key="Normal">
            <Grid Margin="0,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DisplayName}" Style="{StaticResource tb}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Value,UpdateSourceTrigger=PropertyChanged}" x:Name="tbString" />

                <ItemsControl Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="1" ItemsSource="{Binding (Validation.Errors),ElementName=tbString}" Visibility="{Binding (Validation.HasError), ElementName=tbString, Converter={StaticResource Boolean2VisibilityConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ErrorContent,Converter={StaticResource ObjStringConverter}}" Foreground="Red"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Number">
            <Grid Margin="0,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DisplayName}" Style="{StaticResource tb}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Value,UpdateSourceTrigger=PropertyChanged}" x:Name="tbNumber" />

                <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding (Validation.Errors),ElementName=tbNumber}" Visibility="{Binding (Validation.HasError), ElementName=tbNumber, Converter={StaticResource Boolean2VisibilityConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ErrorContent,Converter={StaticResource ObjStringConverter}}" Foreground="Red"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Bool">
            <Grid Margin="0,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DisplayName}" Style="{StaticResource tb}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding Value, Converter={StaticResource StringBoolConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=False}" x:Name="cbBool" />

                <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding (Validation.Errors),ElementName=cbBool}" Visibility="{Binding (Validation.HasError), ElementName=cbBool, Converter={StaticResource Boolean2VisibilityConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ErrorContent,Converter={StaticResource ObjStringConverter}}" Foreground="Red"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Enum">
            <Grid Margin="0,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DisplayName}" Style="{StaticResource tb}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Options}" SelectedValue="{Binding Value,UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Value" DisplayMemberPath="Key" x:Name="cb" />

                <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding (Validation.Errors),ElementName=cb}" Visibility="{Binding (Validation.HasError), ElementName=cb, Converter={StaticResource Boolean2VisibilityConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ErrorContent,Converter={StaticResource ObjStringConverter}}" Foreground="Red"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DateTime">
            <Grid Margin="0,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DisplayName}" Style="{StaticResource tb}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker Grid.Row="0" Grid.Column="1" SelectedDate="{Binding Value,UpdateSourceTrigger=PropertyChanged}" x:Name="dtp" />

                <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding (Validation.Errors),ElementName=dtp}" Visibility="{Binding (Validation.HasError), ElementName=dtp, Converter={StaticResource Boolean2VisibilityConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ErrorContent,Converter={StaticResource ObjStringConverter}}" Foreground="Red"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Date">
            <Grid Margin="0,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DisplayName}" Style="{StaticResource tb}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker Grid.Row="0" Grid.Column="1" SelectedDate="{Binding Value,UpdateSourceTrigger=PropertyChanged}" x:Name="dp" />

                <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding (Validation.Errors),ElementName=dp}" Visibility="{Binding (Validation.HasError), ElementName=dp, Converter={StaticResource Boolean2VisibilityConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ErrorContent,Converter={StaticResource ObjStringConverter}}" Foreground="Red"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Time">
            <Grid Margin="0,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DisplayName}" Style="{StaticResource tb}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Value,UpdateSourceTrigger=PropertyChanged}" x:Name="tp" />

                <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding (Validation.Errors),ElementName=tp}" Visibility="{Binding (Validation.HasError), ElementName=tp, Converter={StaticResource Boolean2VisibilityConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ErrorContent,Converter={StaticResource ObjStringConverter}}" Foreground="Red"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </DataTemplate>

        <!-- Array and Object templates: adjust header to align with labels, use Expander to collapse details -->
        <DataTemplate x:Key="Array" DataType="vms:ConfigViewModel">
            <StackPanel>
                <Expander IsExpanded="False" Margin="0,0,0,8">
                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" Style="{StaticResource tb}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Dim, StringFormat='[{0}]'}" Style="{StaticResource tb}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <Button ToolTip="Add" Content="+" Command="{Binding AddCommand,ElementName=page}" CommandParameter="{Binding .}" Style="{StaticResource ButtonActionStyle}" FontWeight="Bold" Margin="0,0,4,0"/>
                            </StackPanel>
                        </Grid>
                    </Expander.Header>

                    <Border CornerRadius="8" BorderBrush="#D0D0D0" BorderThickness="1" Padding="8" Background="#FAFAFA">
                        <ItemsControl ItemsSource="{Binding Properties}" AlternationCount="{Binding Properties.Count}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1" Margin="4" Padding="8" Background="#FFF">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <DockPanel Grid.Row="0" VerticalAlignment="Top">
                                                <TextBlock>
                                                    <Run Text="Element "/>
                                                    <Run Text="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ContentPresenter}}, Mode=OneWay, Converter={StaticResource ObjStringConverter}}"/>
                                                </TextBlock>
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                    <Button ToolTip="Move Up" Content="▲" Style="{StaticResource ButtonActionStyle}" Command="{Binding UpCommand,ElementName=page}" CommandParameter="{Binding .}" Margin="0,0,8,0"/>
                                                    <Button ToolTip="Move Down" Content="▼" Style="{StaticResource ButtonActionStyle}" Command="{Binding DownCommand,ElementName=page}" CommandParameter="{Binding .}" Margin="0,0,8,0"/>
                                                    <Button ToolTip="Delete" Content="✖" Style="{StaticResource ButtonDeleteStyle}" Command="{Binding RemoveCommand,ElementName=page}" CommandParameter="{Binding .}" Margin="0,0,8,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <local:PropertiyView DataContext="{Binding}" Grid.Row="1" Padding="0,0,10,0"
                                                                  AddCommand="{Binding AddCommand, RelativeSource={RelativeSource AncestorType=local:PropertiyView}}"
                                                                  SetObjectCommand="{Binding SetObjectCommand, RelativeSource={RelativeSource AncestorType=local:PropertiyView}}"
                                                                  CopyCommand="{Binding CopyCommand, RelativeSource={RelativeSource AncestorType=local:PropertiyView}}"
                                                                  PasteCommand="{Binding PasteCommand, RelativeSource={RelativeSource AncestorType=local:PropertiyView}}"
                                                                  RemoveCommand="{Binding RemoveCommand, RelativeSource={RelativeSource AncestorType=local:PropertiyView}}"
                                                                  UpCommand="{Binding UpCommand, RelativeSource={RelativeSource AncestorType=local:PropertiyView}}"
                                                                  DownCommand="{Binding DownCommand, RelativeSource={RelativeSource AncestorType=local:PropertiyView}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Expander>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Object" DataType="vms:ConfigViewModel">
            <StackPanel>
                <Expander IsExpanded="False" Margin="0,0,0,8">
                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" Style="{StaticResource tb}" FontWeight="Bold" FontSize="14" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Visibility="{Binding Value,Converter={StaticResource String2VisibilityReConverter}}" Content="Create" Command="{Binding SetObjectCommand,ElementName=page}" CommandParameter="{Binding .}" Style="{StaticResource ButtonActionStyle}" Margin="0,0,8,0"/>
                            </StackPanel>
                        </Grid>
                    </Expander.Header>

                    <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="8" Padding="10" Background="#FAFAFA">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Properties}" Visibility="{Binding Value,Converter={StaticResource String2VisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" BorderBrush="#E0E0E0" BorderThickness="1" Margin="4" Padding="8" Background="#FFF">
                                            <local:PropertiyView DataContext="{Binding}" Margin="2,0"
                                                                  AddCommand="{Binding AddCommand, RelativeSource={RelativeSource AncestorType=local:PropertiyView}}"
                                                                  SetObjectCommand="{Binding SetObjectCommand, RelativeSource={RelativeSource AncestorType=local:PropertiyView}}"
                                                                  CopyCommand="{Binding CopyCommand, RelativeSource={RelativeSource AncestorType=local:PropertiyView}}"
                                                                  PasteCommand="{Binding PasteCommand, RelativeSource={RelativeSource AncestorType=local:PropertiyView}}"
                                                                  RemoveCommand="{Binding RemoveCommand, RelativeSource={RelativeSource AncestorType=local:PropertiyView}}"
                                                                  UpCommand="{Binding UpCommand, RelativeSource={RelativeSource AncestorType=local:PropertiyView}}"
                                                                  DownCommand="{Binding DownCommand, RelativeSource={RelativeSource AncestorType=local:PropertiyView}}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Expander>
            </StackPanel>
        </DataTemplate>

        <converters:PropertyTypeConverter x:Key="propertyTypeConverter" BooleanTemplate="{StaticResource Bool}" StringTemplate="{StaticResource Normal}" NumberTemplate="{StaticResource Number}" HasOptionTemplate="{StaticResource Enum}" DateTimeTemplate="{StaticResource DateTime}" TimeOnlyTemplate="{StaticResource Time}" DateOnlyTemplate="{StaticResource Date}" ArrayTemplate="{StaticResource Array}" ObjectTemplate="{StaticResource Object}"/>
    </UserControl.Resources>

    <ContentControl Content="{Binding .}" ContentTemplateSelector="{StaticResource propertyTypeConverter}" Validation.ErrorTemplate="{x:Null}" ToolTip="{Binding Description}"/>
</UserControl>